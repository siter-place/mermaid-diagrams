meta {
  name: Reject missing receipt
  type: http
  seq: 1
}

post {
  url: {{apiRoot}}/diagrams
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Invalid Unvalidated Diagram",
    "source": "invalid mermaid code -->>> syntax error"
  }
}

assert {
  res.status: eq 422
  res.body.code: eq "mdm_invalid_mermaid"
}
