meta {
  name: Get diagram
  type: http
  seq: 3
}

get {
  url: {{apiRoot}}/diagrams/{{diagramId}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.id: eq {{diagramId}}
  res.body.versionToken: isString
}

script:post-response {
  if (res.body && res.body.versionToken) {
    bru.setVar("diagramVersion", res.body.versionToken);
  }
}
