meta {
  name: Create valid diagram
  type: http
  seq: 2
}

post {
  url: {{apiRoot}}/diagrams
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Idempotency-Key: bruno-{{$guid}}
}

body:json {
  {
    "title": "Bruno Flow",
    "source": "flowchart LR\n  A --> B",
    "status": "draft",
    "validation": {
      "sourceHash": "sha256:e07394221b261392d5bdb2f23bd063207925a4689b5271ddba5a07b0da56dfd4",
      "mermaidVersion": "11.4.1",
      "diagramType": "flowchart",
      "validatedAt": "2026-08-01T20:00:00.000Z",
      "profile": "worker"
    }
  }
}

script:pre-request {
  req.setBody({
    title: "Bruno Flow " + Date.now(),
    source: "flowchart LR\n  A --> B",
    status: "draft",
    validation: {
      sourceHash: "sha256:e07394221b261392d5bdb2f23bd063207925a4689b5271ddba5a07b0da56dfd4",
      mermaidVersion: "11.4.1",
      diagramType: "flowchart",
      validatedAt: new Date().toISOString(),
      profile: "worker"
    }
  });
}

assert {
  res.status: in [200, 201]
  res.body.id: isNumber
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar("diagramId", res.body.id);
    bru.setVar("diagramVersion", res.body.versionToken);
  }
}
