meta {
  name: Patch settings section
  type: http
  seq: 2
}

patch {
  url: {{apiRoot}}/settings/rendering
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "defaultTheme": "forest",
    "defaultHeight": 500
  }
}

assert {
  res.status: eq 200
  res.body.defaultTheme: eq "forest"
  res.body.defaultHeight: eq 500
}
