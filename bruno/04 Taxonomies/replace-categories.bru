meta {
  name: Replace diagram categories
  type: http
  seq: 1
}

patch {
  url: {{apiRoot}}/diagrams/{{diagramId}}/categories
  body: json
  auth: inherit
}

body:json {
  {
    "operation": "replace",
    "termIds": [{{categoryId}}],
    "expectedVersion": "{{diagramVersion}}"
  }
}

assert {
  res.status: eq 200
}
