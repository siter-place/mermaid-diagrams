<?xml version="1.0"?>
<ruleset name="MermaidDiagramsCodingStandards">
	<description>PHPCS ruleset for Mermaid Diagrams plugin.</description>

	<file>src/</file>
	<file>mermaid-diagrams.php</file>

	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>
	<exclude-pattern>/build/</exclude-pattern>

	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="extensions" value="php"/>

	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Extra"/>

	<!-- PSR-4 class filenames in src/ -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>src/*</exclude-pattern>
	</rule>

	<config name="text_domain" value="mermaid-diagrams"/>
	<config name="minimum_supported_wp_version" value="7.0"/>
</ruleset>
