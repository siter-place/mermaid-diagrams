{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "checkJs": false,
    "noImplicitAny": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@apps/*": ["apps/*"],
      "@packages/*": ["packages/*"],
      "@mdm/mermaid-runtime/*": ["packages/mermaid-runtime/src/*"]
    }
  },
  "include": [
    "assets/src/**/*",
    "apps/**/*",
    "packages/**/*",
    "tests/**/*",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "vendor"
  ]
}
